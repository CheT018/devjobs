{
  "name": "devjobs",
  "private": true,
  "version": "0.1.0",
  "description": "Portal de empleo para desarrolladores: búsqueda, filtros y detalle de ofertas.",
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "lint": "oxlint --deny-warnings",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @devjobs/api test",
    "test:e2e": "pnpm --filter @devjobs/e2e test",
    "seed": "pnpm --filter @devjobs/api seed"
  },
  "devDependencies": {
    "oxlint": "1.94.0",
    "typescript": "7.0.2"
  }
}
