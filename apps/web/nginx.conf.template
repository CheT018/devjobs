# Plantilla de nginx: al arrancar el contenedor, ${API_URL} se sustituye por
# la variable de entorno del mismo nombre.
server {
  listen 8080;
  server_name _;
  server_tokens off;

  root /usr/share/nginx/html;
  index index.html;

  add_header X-Content-Type-Options "nosniff" always;
  add_header X-Frame-Options "DENY" always;
  add_header Referrer-Policy "strict-origin-when-cross-origin" always;

  location /api/ {
    proxy_pass ${API_URL};
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  # Los archivos generados por Vite llevan un hash en el nombre
  location /assets/ {
    expires 1y;
    try_files $uri =404;
  }

  # Las rutas de la aplicación las resuelve React Router
  location / {
    try_files $uri /index.html;
  }
}
